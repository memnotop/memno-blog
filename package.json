{
  "name": "memno-blog",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:check": "astro check --watch & astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "test": "tsx --test tests/**/*.test.ts",
    "astro": "astro",
    "format": "prettier --write astro.config.ts uno.config.ts eslint.config.mjs prettier.config.mjs 'scripts/**/*.ts' 'src/**/*.{ts,astro}' 'tests/**/*.ts'",
    "format:check": "prettier --check astro.config.ts uno.config.ts eslint.config.mjs prettier.config.mjs 'scripts/**/*.ts' 'src/**/*.{ts,astro}' 'tests/**/*.ts'",
    "lint": "eslint --fix astro.config.ts uno.config.ts 'scripts/**/*.ts' 'src/**/*.{ts,astro}' 'tests/**/*.ts'",
    "lint:check": "eslint astro.config.ts uno.config.ts 'scripts/**/*.ts' 'src/**/*.{ts,astro}' 'tests/**/*.ts'",
    "clean": "rm -rf .astro dist node_modules/.astro",
    "new:post": "tsx scripts/new-post.ts",
    "date": "tsx scripts/updateBlogDates.ts",
    "audit:repo": "tsx scripts/auditRepoHealth.ts",
    "images:webp": "tsx scripts/optimizeImagesToWebp.ts",
    "verify": "npm run lint:check && npm run format:check && npm run check && npm run test && npm run build && npm run audit:repo",
    "github": "git add . && git commit -m \"update\" && git push origin main"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@waline/client": "^3.6.0",
    "astro": "^7.0.7",
    "astro-pure": "file:packages/pure",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^1.3.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.3",
    "typescript": "^5.8.3",
    "unocss": "^66.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/node": "^22.9.0",
    "@unocss/astro": "^66.7.5",
    "eslint": "^9.31.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.19.1",
    "typescript-eslint": "^8.37.0"
  },
  "description": "memno.top personal site",
  "private": true
}
