---
import PageLayout from '@/layouts/BaseLayout.astro'
import { loadTrainingRecords } from '@/utils/training'

import '@/assets/styles/training.css'

const trainingRecords = await loadTrainingRecords()
const trainingJson = JSON.stringify(trainingRecords).replace(/</g, '\\u003c')
---

<PageLayout meta={{ title: 'Training' }} highlightColor='#8fcf91'>
  <main class='training-page animate' id='content'>
    <div class='training-board' id='training-board'>
      <div class='training-summary'>
        <div>
          <p class='training-eyebrow'>Training Log</p>
          <h1>训练记录</h1>
          <p>展示最近一年的训练完成情况。点击色块可以查看当天训练内容。</p>
        </div>
        <div class='training-legend' aria-label='训练感受颜色说明'>
          <span>轻松</span>
          <i class='training-cell level-1'></i>
          <i class='training-cell level-2'></i>
          <i class='training-cell level-3'></i>
          <i class='training-cell level-4'></i>
          <i class='training-cell level-5'></i>
          <span>困难</span>
        </div>
      </div>

      <div class='training-heatmap' aria-label='训练日期选择'>
        <div class='training-chart-wrap'>
          <div class='training-months' id='training-months'></div>
          <div class='training-chart'>
            <div class='training-weekdays' aria-hidden='true'>
              <span></span>
              <span>Mon</span>
              <span></span>
              <span>Wed</span>
              <span></span>
              <span>Fri</span>
              <span></span>
            </div>
            <div class='training-grid' id='training-grid'></div>
          </div>
        </div>
      </div>

      <div class='training-detail' id='training-detail'></div>
    </div>
  </main>
</PageLayout>

<script id='training-data' type='application/json' is:inline set:html={trainingJson} />
<script>
  import { initTrainingPage } from '@/scripts/training'

  initTrainingPage()
</script>
