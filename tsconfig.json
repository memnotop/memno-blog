{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "uno.config.ts",
    "scripts/**/*.ts",
    "src/**/*",
    "tests/**/*.ts"
  ],
  "compilerOptions": {
    "lib": ["es2022", "dom", "dom.iterable"],
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "strictNullChecks": true,
    "paths": {
      "@/assets/*": ["src/assets/*"],
      "@/components/*": ["src/components/*"],
      "@/layouts/*": ["src/layouts/*"],
      "@/scripts/*": ["src/scripts/*"],
      "@/utils/*": ["src/utils/*"],
      "@/plugins/*": ["src/plugins/*"],
      "@/pages/*": ["src/pages/*"],
      "@/site-config": ["src/site.config.ts"]
    }
  },
  "exclude": [
    ".astro",
    ".obsidian",
    "dist",
    "node_modules",
    "packages/pure",
    "public",
    "source"
  ]
}
